# Vaani — drop the key for whichever Gemma 4 backend you want to use.
# Whichever one is set wins. Order: AI Studio > OpenRouter > local Ollama.
#
# (Don't set any of these and have Ollama installed → uses local.)
# (Set none of them and no Ollama → app refuses to start.)

# Google AI Studio  (free key: https://aistudio.google.com/apikey)
# GEMINI_API_KEY=

# OpenRouter  (paid: https://openrouter.ai/keys)
# OPENROUTER_API_KEY=

# Local Ollama  (no key — just `ollama pull gemma4:e4b`)
# Optional: pick a different size
# VAANI_OLLAMA_MODEL=gemma4:e4b
